{
  "compilerOptions": {
    "module": "esnext",
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2020",
    "moduleResolution": "node",
    "rootDir": "./src",
    "lib": [
      "es2020"
    ],
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
